name: home-ollama
services:
  ollama:
    image: "{{ ollama_image }}"
    container_name: ollama
    restart: unless-stopped
    ports:
      - "{{ ollama_bind_address }}:{{ ollama_port }}:11434"
    volumes:
      - "{{ ollama_data_dir }}:/models"
    environment:
      OLLAMA_MODELS: /models
    mem_limit: 2g
    cpus: 2.0
    logging:
      driver: json-file
      options: {max-size: 10m, max-file: "3"}
    security_opt: [no-new-privileges:true]
